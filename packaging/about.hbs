<h2 id="uebersicht">Lizenzen</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a></li>
{{/each}}
</ul>

<h2 id="texte">Lizenztexte</h2>
{{#each licenses}}
<section>
<h3{{#if first_of_kind}} id="{{id}}"{{/if}}>{{name}}</h3>
<ul class="crates">
{{#each used_by}}
{{#if crate.source}}
<li><a href="https://crates.io/crates/{{crate.name}}/{{crate.version}}">{{crate.name}} {{crate.version}}</a>{{#if crate.authors}} <span class="who">({{#each crate.authors}}{{#unless @first}}, {{/unless}}{{this}}{{/each}})</span>{{/if}}</li>
{{/if}}
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</main>
</body>
</html>
